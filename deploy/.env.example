# Copy to .env.production (never commit). Writes/outbound/paid enrichment are OFF by default and must be enabled deliberately.
RI_ENV=production
DATABASE_URL=postgresql://postgres:CHANGE@db:5432/ri
RI_AUTH_MODE=oidc
RI_OIDC_ISSUER=
RI_OIDC_AUDIENCE=
RI_OIDC_JWKS_URL=
RI_CRM_WRITES_ENABLED=false
RI_OUTBOUND_ENABLED=false
RI_PAID_ENRICHMENT_ENABLED=false
PIPEDRIVE_DOMAIN=thecodestltd
PIPEDRIVE_API_TOKEN_FILE=/run/secrets/pipedrive_read
PIPEDRIVE_WEBHOOK_SECRET_FILE=/run/secrets/pipedrive_webhook
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google_sa.json
EXA_API_KEY_FILE=/run/secrets/exa
ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic
SLACK_WEBHOOK_URL_FILE=/run/secrets/slack
RI_BASE_URL=https://ri.example.invalid
RI_LINK_SECRET_FILE=/run/secrets/link_secret
